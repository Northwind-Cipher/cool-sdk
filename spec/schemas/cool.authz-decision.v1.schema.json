{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Northwind-Cipher/cool-sdk/spec/schemas/cool.authz-decision.v1.schema.json",
  "title": "cool.authz-decision.v1",
  "description": "Signed authorization decision. decision is permit | deny | indeterminate | error; assurance is trusted | reproducible.",
  "type": "object",
  "required": [
    "body",
    "digest",
    "signature",
    "signer"
  ],
  "properties": {
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "decision_id",
        "decision",
        "request_id",
        "request_digest",
        "principal",
        "nonce",
        "policy",
        "evaluator",
        "input_digest",
        "assurance",
        "reasons",
        "decided_at",
        "valid_until"
      ],
      "properties": {
        "schema": {
          "const": "cool.authz-decision.v1"
        },
        "decision_id": {
          "type": "string"
        },
        "decision": {
          "enum": [
            "permit",
            "deny",
            "indeterminate",
            "error"
          ]
        },
        "request_id": {
          "type": "string"
        },
        "request_digest": {
          "type": "string",
          "pattern": "^mh:sha256:[0-9a-f]{64}$"
        },
        "principal": {
          "type": "string"
        },
        "nonce": {
          "type": "string"
        },
        "policy": {
          "type": "object",
          "required": [
            "id",
            "version",
            "digest"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^mh:sha256:[0-9a-f]{64}$"
            }
          }
        },
        "evaluator": {
          "type": "object",
          "required": [
            "id",
            "version"
          ]
        },
        "input_digest": {
          "type": "string",
          "pattern": "^mh:sha256:[0-9a-f]{64}$"
        },
        "assurance": {
          "enum": [
            "trusted",
            "reproducible"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decided_at": {
          "type": "string"
        },
        "valid_until": {
          "type": "string"
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^mh:sha256:[0-9a-f]{64}$"
    },
    "signature": {
      "type": "object",
      "required": [
        "alg",
        "key_id",
        "ml_dsa",
        "ed25519"
      ],
      "properties": {
        "alg": {
          "const": "ml-dsa-65+ed25519"
        }
      }
    },
    "signer": {
      "type": "object",
      "required": [
        "ml_dsa_pub",
        "ed25519_pub"
      ]
    }
  }
}
